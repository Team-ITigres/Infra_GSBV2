services:
  nextcloud-db:
    image: mariadb:{{ mariadb_version }}
    container_name: {{ nextcloud_db_container_name }}
    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW
    restart: unless-stopped
    volumes:
      - nextcloud-db-data:/var/lib/mysql
    environment:
      MYSQL_ROOT_PASSWORD: {{ nextcloud_db_root_password }}
      MYSQL_DATABASE: {{ nextcloud_db_name }}
      MYSQL_USER: {{ nextcloud_db_user }}
      MYSQL_PASSWORD: {{ nextcloud_db_password }}
    networks:
      - nextcloud-internal
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  nextcloud-redis:
    image: redis:{{ redis_version }}
    container_name: {{ nextcloud_redis_container_name }}
    restart: unless-stopped
    command: redis-server --requirepass {{ nextcloud_db_password }}
    networks:
      - nextcloud-internal
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  nextcloud:
    image: nextcloud:{{ nextcloud_version }}
    container_name: {{ nextcloud_container_name }}
    restart: unless-stopped
    ports:
      - "{{ nextcloud_port }}:80"
    volumes:
      - nextcloud-data:/var/www/html
      - nextcloud-custom-apps:/var/www/html/custom_apps
      - nextcloud-config:/var/www/html/config
      - nextcloud-themes:/var/www/html/themes
    environment:
      # Database
      MYSQL_HOST: {{ nextcloud_db_container_name }}
      MYSQL_DATABASE: {{ nextcloud_db_name }}
      MYSQL_USER: {{ nextcloud_db_user }}
      MYSQL_PASSWORD: {{ nextcloud_db_password }}

      # Redis
      REDIS_HOST: {{ nextcloud_redis_container_name }}
      REDIS_HOST_PASSWORD: {{ nextcloud_db_password }}

      # Admin user
      NEXTCLOUD_ADMIN_USER: {{ nextcloud_admin_user }}
      NEXTCLOUD_ADMIN_PASSWORD: {{ nextcloud_admin_password }}

      # Trusted domains
      NEXTCLOUD_TRUSTED_DOMAINS: "{{ ansible_host }} localhost {{ ansible_hostname }}"

      # Performance
      PHP_MEMORY_LIMIT: 512M
      PHP_UPLOAD_LIMIT: 2G

      # Timezone
      TZ: Europe/Paris
    networks:
      - nextcloud-internal
    depends_on:
      nextcloud-db:
        condition: service_healthy
      nextcloud-redis:
        condition: service_healthy

volumes:
  nextcloud-db-data:
  nextcloud-data:
  nextcloud-custom-apps:
  nextcloud-config:
  nextcloud-themes:

networks:
  nextcloud-internal:
    driver: bridge
